CREATE TABLE uyeler(
                 id  INTEGER PRIMARY KEY AUTOINCREMENT,
				 ad TEXT NOT NULL,
				 yas INTEGER CHECK (yas&gt;13),
				 sehir TEXT DEFAULT 'Erzincan',
				 kayit TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE kitaplar(
                   id INTEGER PRIMARY KEY AUTOINCREMENT,
                   kitap TEXT UNIQUE NOT NULL

);



CREATE TABLE odunc(
                   uye_id INTEGER REFERENCES uyeler(id) ON DELETE CASCADE,
				   kitap_id INTEGER REFERENCES kitaplar(id),
                   verilis_tarihi TEXT DEFAULT CURRENT_TIMESTAMP,
				   gun_sayisi INTEGER,
				   PRIMARY KEY (uye_id, kitap_id)
 );
 
 ----DROP TABLE odunc;
 
 
