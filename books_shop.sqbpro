(9, 5, 28),
(10, 1, 19),
(10, 4, 44);

--- Select query displaying member name, book title, and borrow days in a single table.
SELECT 
    members.name AS member_name, 
    books.title AS book_title, 
    borrows.borrow_days
FROM borrows
JOIN members ON borrows.member_id = members.id
JOIN books ON borrows.book_id = books.id;

----- Query to filter books borrowed for more than 30 days.
SELECT 
    members.name AS member_name, 
    books.title AS book_title, 
    borrows.borrow_days
FROM borrows
JOIN members ON borrows.member_id = members.id
JOIN books ON borrows.book_id = books.id
WHERE borrows.borrow_days &gt; 30;

SELECT 
    members.name AS member_name, 
    members.city, 
    books.title AS book_title, 
    borrows.borrow_days
FROM borrows
JOIN members ON borrows.member_id = members.id
JOIN books ON borrows.book_id = books.id
WHERE members.city = 'Los Angeles';

--- (Advanced) LEFT JOIN to list members even if they haven't borrowed any books.
SELECT 
    members.name AS member_name, 
    members.city, 
    books.title AS book_title, 
    borrows.borrow_days
FROM members
LEFT JOIN borrows ON members.id = borrows.member_id
LEFT JOIN books ON borrows.book_id = books.id;


-- Grouping and Aggregation Functions
-- Calculate average borrow duration, total books borrowed, and max borrow days per member.
-- Filter members with an average duration greater than 20 days using HAVING instead of WHERE.
-- Count how many times each book has been borrowed along with its title.
-- Count members per city ordered from highest to lowest.

SELECT 
    members.name AS member_name,
    COUNT(borrows.book_id) AS borrowed_book_count,
    AVG(borrows.borrow_days) AS average_days,
    MAX(borrows.borrow_days) AS max_days
FROM members
JOIN borrows ON members.id = borrows.member_id
GROUP BY members.id, members.name
HAVING AVG(borrows.borrow_days) &gt; 20;

SELECT 
    books.title AS book_title,
    COUNT(borrows.book_id) AS times_borrowed
FROM books
LEFT JOIN borrows ON books.id = borrows.book_id
GROUP BY books.id, books.title;

SELECT 
    city,
    COUNT(*) AS member_count
FROM members
GROUP BY city
ORDER BY member_count DESC;


-- Subquery
-- List names of members who borrowed at least one book for more than 30 days using a subquery.
-- Find books that have never been borrowed using NOT IN.
-- List all records where borrow duration is above the general average.

SELECT name 
FROM members 
WHERE id IN (
    SELECT DISTINCT member_id 
    FROM borrows 
    WHERE borrow_days &gt; 30
);

SELECT title 
FROM books 
WHERE id NOT IN (
    SELECT DISTINCT book_id 
    FROM borrows 
    WHERE book_id IS NOT NULL
);

SELECT 
    members.name AS member_name,
    books.title AS book_title,
    borrows.borrow_days
FROM borrows
JOIN members ON borrows.member_id = members.id
JOIN books ON borrows.book_id = books.id
WHERE borrows.borrow_days &gt; (
    SELECT AVG(borrow_days) 
    FROM borrows
);


-- CASE
-- Generate status for each record: > 30 days 'Overdue', 15–30 'Warning', others 'Normal'.
-- Label members as 'Youth' (≤18) or 'Adult' based on age.
-- (Advanced) Count total records per status using CASE + GROUP BY.

SELECT 
    borrows.member_id,
    borrows.book_id,
    borrows.borrow_days,
    CASE 
        WHEN borrows.borrow_days &gt; 30 THEN 'Overdue'
        WHEN borrows.borrow_days BETWEEN 15 AND 30 THEN 'Warning'
        ELSE 'Normal'
    END AS status
FROM borrows;

SELECT 
    name,
    age,
    CASE 
        WHEN age &lt;= 18 THEN 'Youth'
        ELSE 'Adult'
    END AS age_group
FROM members;

SELECT 
    CASE 
        WHEN borrow_days &gt; 30 THEN 'Overdue'
        WHEN borrow_days BETWEEN 15 AND 30 THEN 'Warning'
        ELSE 'Normal'
    END AS status,
    COUNT(*) AS record_count
FROM borrows
GROUP BY 
    CASE 
        WHEN borrow_days &gt; 30 THEN 'Overdue'
        WHEN borrow_days BETWEEN 15 AND 30 THEN 'Warning'
        ELSE 'Normal'
    END;


-- Index
-- Create an index on members.name.
-- Add an email column with ALTER TABLE and create a UNIQUE index.

CREATE INDEX idx_members_name ON members(name);
    
SELECT * FROM members WHERE name = 'John Doe';

