SELECT s.name AS student_name, c.name AS course_name, g.score
FROM grades g
JOIN students s ON s.id = g.student_id
JOIN courses c ON c.id = g.course_id;

-- GROUPING AND AGGREGATION FUNCTIONS
SELECT student_id, AVG(score) AS average_score, COUNT(*) AS course_count, MAX(score) AS max_score
FROM grades
GROUP BY student_id
HAVING AVG(score) &gt; 75;


-- SUBQUERY
SELECT name FROM students
WHERE id IN (SELECT student_id FROM grades WHERE score &gt; 85);


-- CASE
SELECT name, score,
CASE WHEN score &gt;= 85 THEN 'A' WHEN score &gt;= 70 THEN 'B' ELSE 'F' END AS grade_letter
FROM grades JOIN students ON students.id = grades.student_id;


-- INDEX
CREATE INDEX idx_student_name ON students(name);
CREATE UNIQUE INDEX idx_email ON students(email);

</sql><sql name="SQL 3*">PRAGMA foreign_keys = ON;

CREATE TABLE members(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    age INTEGER CHECK (age &gt; 13),
    city TEXT DEFAULT 'New York',
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE books(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT UNIQUE NOT NULL
);

CREATE TABLE borrows(
    member_id INTEGER REFERENCES members(id) ON DELETE CASCADE,
    book_id INTEGER REFERENCES books(id),
    borrow_date TEXT DEFAULT CURRENT_TIMESTAMP,
    borrow_days INTEGER,
    PRIMARY KEY (member_id, book_id)
);
 
----DROP TABLE borrows;
 
INSERT INTO books (title) VALUES
('The Great Gatsby'),
('Crime and Punishment'),
('To Kill a Mockingbird'),
('1984'),
('The Catcher in the Rye');

INSERT INTO members (name, age, city) VALUES
('John Doe', 21, 'New York'),
('Alice Smith', 19, 'Chicago'),
